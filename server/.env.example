PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro

# JWT Auth Secrets
JWT_ACCESS_SECRET=hotelpro_super_secure_access_secret_2026_xyz
JWT_REFRESH_SECRET=hotelpro_super_secure_refresh_secret_2026_abc
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretValue456
RAZORPAY_WEBHOOK_SECRET=sampleWebhookSecret789

# Google Gemini API
GEMINI_API_KEY=

# Email SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test@ethereal.email
SMTP_PASS=testpass
FROM_EMAIL=noreply@hotelpro.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=sample_secret
